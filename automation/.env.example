# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID=@your_channel_handle

# Autonomous AI Tech Radar (Firecrawl + LLM)
USE_AI_RADAR=true

# PASTE YOUR FIRECRAWL API KEY HERE (from https://www.firecrawl.dev)
FIRECRAWL_API_KEY=

# PASTE YOUR GOOGLE GEMINI API KEY HERE (from https://aistudio.google.com)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if you prefer OpenAI)
OPENAI_API_KEY=

# General settings
SIMULATE_MODE=false
